{
    "name": "personal-card",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.8.0",
    "scripts": {
        "dev:api": "pnpm --filter api start:dev",
        "dev:public": "pnpm --filter public dev",
        "build": "pnpm --filter api build && pnpm --filter public build",
        "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" && pnpm db:format",
        "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.mjs\" \"eslint.config.mjs\"",
        "typecheck": "pnpm --filter api typecheck && pnpm --filter public typecheck",
        "lint": "pnpm --filter api lint && pnpm --filter public lint",
        "lint:fix": "pnpm --filter api lint:fix && pnpm --filter public lint:fix",
        "pre-commit:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
        "db:format": "pnpm --filter api db:format",
        "db:validate": "pnpm --filter api db:validate",
        "db:e2e:up": "docker compose -f compose.e2e.yaml up -d --wait",
        "db:e2e:down": "docker compose -f compose.e2e.yaml down -v",
        "db:migrate:e2e": "pnpm --filter api db:migrate:e2e",
        "test": "pnpm --filter api test",
        "test:e2e": "node scripts/run-e2e.mjs"
    },
    "author": "Michael E. Ershov",
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "eslint": "^9.18.0",
        "eslint-config-next": "16.3.3",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.0.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
}
