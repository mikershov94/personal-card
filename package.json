{
    "name": "personal-card",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.8.0",
    "scripts": {
        "dev:api": "pnpm --filter api start:dev",
        "dev:public": "pnpm --filter public dev",
        "build": "pnpm build:api && pnpm build:public",
        "build:api": "pnpm --filter api build",
        "build:public": "pnpm --filter public build",
        "codegen": "pnpm --filter public codegen",
        "codegen:check": "pnpm --filter public codegen:check",
        "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs,mts,css,json}\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" && pnpm db:format",
        "format:check": "pnpm format:check:api && pnpm format:check:public",
        "format:check:api": "prettier --check \"apps/api/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.mjs\" \"eslint.config.mjs\"",
        "format:check:public": "prettier --check \"apps/public/**/*.{ts,tsx,js,mjs,cjs,mts,css,json}\"",
        "typecheck": "pnpm typecheck:api && pnpm typecheck:public",
        "typecheck:api": "pnpm --filter api typecheck",
        "typecheck:public": "pnpm --filter public typecheck",
        "lint": "pnpm lint:api && pnpm lint:public",
        "lint:api": "pnpm --filter api lint",
        "lint:public": "pnpm --filter public lint",
        "lint:fix": "pnpm --filter api lint:fix && pnpm --filter public lint:fix",
        "pre-commit:check": "pnpm pre-commit:check:api && pnpm pre-commit:check:public",
        "pre-commit:check:api": "pnpm format:check:api && pnpm lint:api && pnpm typecheck:api && pnpm test:api",
        "pre-commit:check:public": "pnpm codegen:check && pnpm format:check:public && pnpm lint:public && pnpm typecheck:public && pnpm test:public",
        "db:format": "pnpm --filter api db:format",
        "db:validate": "pnpm --filter api db:validate",
        "db:e2e:up": "docker compose -f compose.e2e.yaml up -d --wait",
        "db:e2e:down": "docker compose -f compose.e2e.yaml down -v",
        "db:migrate:e2e": "pnpm --filter api db:migrate:e2e",
        "db:seed": "pnpm --filter api db:seed",
        "test": "pnpm test:api && pnpm test:public",
        "test:api": "pnpm --filter api test",
        "test:public": "pnpm --filter public test",
        "test:e2e": "node scripts/run-e2e.mjs"
    },
    "author": "Michael E. Ershov",
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "eslint": "^9.18.0",
        "eslint-config-next": "16.3.3",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.0.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
}
